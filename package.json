{
  "name": "hyper-terminal-windows",
  "version": "0.1.0",
  "description": "An Omarchy-inspired terminal for Windows",
  "author": "Hyper Terminal contributors",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "build": "esbuild src/renderer.js --bundle --outdir=dist --loader:.css=css",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "test:pty": "electron tests/pty-smoke.cjs",
    "test:ui": "electron tests/ui-smoke.cjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "dev.hyperterminal.windows",
    "productName": "Hyper Terminal",
    "directories": { "output": "release" },
    "files": ["src/main.cjs", "src/preload.cjs", "src/sessions.cjs", "src/index.html", "dist/**/*"],
    "asarUnpack": ["node_modules/node-pty/**/*"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
